// PyroTV: let the backend (system service running as user `pyrotv`) switch
// the Wi-Fi hotspot with nmcli although it has no active login session. Only
// that one user is allowed (not the whole `netdev` group), and only a
// WPA-protected hotspot (no wifi.share.open):
//   nmcli con modify pyrotv-hotspot wifi-sec.psk <pin>   (settings.modify.system)
//   nmcli con up / down pyrotv-hotspot                    (network-control,
//                                                          wifi.share.protected)
// Installed to /etc/polkit-1/rules.d/ by deploy/install.sh (polkit >= 0.106
// JavaScript rules; Bookworm ships polkit 122).
// Action ids checked against NetworkManager's
// data/org.freedesktop.NetworkManager.policy.in. UNVERIFIED on the Pi: which
// of them nmcli really asks for when bringing up the AP; trim if possible.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.share.protected"
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.user == "pyrotv") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
