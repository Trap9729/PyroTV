# /etc/pyrotv.env -- environment for pyrotv.service and kiosk.sh.
#
# install.sh copies this file to /etc/pyrotv.env ONCE (an existing
# /etc/pyrotv.env is kept, so your edits survive re-runs) and then fills in
# the @PYROTV_UID@ placeholders below with the numeric uid of user `pyrotv`.
#
# Format rules (the file is read by systemd's EnvironmentFile= AND parsed by
# kiosk.sh): one KEY=value per line, put values that contain spaces in
# "double quotes", never use $, backticks or backslashes.
#
# After editing: sudo systemctl restart pyrotv   (and reboot for kiosk flags)
# While the overlay root filesystem is active, edits to /etc are LOST on
# reboot: disable the overlay first (see deploy/README.md).

# --- Paths (set by the installer; normally leave alone) ----------------------
PYROTV_DATA_DIR=/data
PYROTV_STATIC=/opt/pyrotv/frontend
PYROTV_CATALOGUE=/opt/pyrotv/catalogue/catalogue.json

# --- Values the hardware spike (Task 0, docs/spike-results.md) determines -----
# PLACEHOLDERS: docs/spike-results.md does not exist yet.

# DRM connector of the TV (the touchscreen is HDMI-A-1). Check with:
#   ls /sys/class/drm        (look for card?-HDMI-A-1 / card?-HDMI-A-2)
PYROTV_TV_CONNECTOR=HDMI-A-2

# PipeWire/PulseAudio sink names for TV audio (HDMI) and the shop speakers
# (3.5 mm jack). Empty = the app never switches the default sink.
# Discover them on the Pi, as user pyrotv, with:
#   sudo -u pyrotv XDG_RUNTIME_DIR=/run/user/$(id -u pyrotv) pactl list short sinks
# Typical names look like alsa_output.platform-fef00700.hdmi.hdmi-stereo and
# alsa_output.platform-bcm2835_audio.stereo-fallback (UNVERIFIED examples).
PYROTV_SINK_HDMI=
PYROTV_SINK_JACK=

# Extra mpv arguments for TV playback (split like a shell command line).
# Hardware decoding candidates to try in the spike (UNVERIFIED on this Pi):
#   PYROTV_MPV_ARGS="--hwdec=v4l2m2m-copy"
#   PYROTV_MPV_ARGS="--hwdec=drm"
PYROTV_MPV_ARGS=

# Extra Chromium flags appended by kiosk.sh (split on spaces), e.g. to try
# GPU options found in the spike:
#   PYROTV_CHROMIUM_EXTRA_FLAGS="--ignore-gpu-blocklist --enable-gpu-rasterization"
PYROTV_CHROMIUM_EXTRA_FLAGS=

# --- Session plumbing (filled in by install.sh; do not edit by hand) ----------
# The backend (a system service running as user pyrotv) spawns mpv into the
# sway session and calls pactl on its PipeWire; all share this runtime dir.
# sway names its socket wayland-1 (it skips wayland-0 on purpose); check with
#   ls /run/user/$(id -u pyrotv)
XDG_RUNTIME_DIR=/run/user/@PYROTV_UID@
WAYLAND_DISPLAY=wayland-1
PULSE_SERVER=unix:/run/user/@PYROTV_UID@/pulse/native

# Development only: 1 = fake mpv/nmcli/HDMI (never on the shop Pi).
PYROTV_FAKE_HW=0
